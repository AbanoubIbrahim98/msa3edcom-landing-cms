@model SiteSettings
@{
    ViewData["Title"] = "SEO & Branding";
}

<form asp-action="Index" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="content-card mb-4">
        <div class="d-flex align-items-center mb-3">
            <span class="card-icon"><i class="bi bi-search"></i></span>
            <div>
                <h5 class="mb-0">SEO Metadata</h5>
                <small class="text-muted">Search engines and link previews</small>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="MetaTitleEn" class="form-label fw-medium">Title (EN)</label>
                <input asp-for="MetaTitleEn" class="form-control" maxlength="160" />
            </div>
            <div class="col-md-6">
                <label asp-for="MetaTitleAr" class="form-label fw-medium">Title (AR)</label>
                <input asp-for="MetaTitleAr" class="form-control" dir="rtl" maxlength="160" />
            </div>

            <div class="col-md-6">
                <label asp-for="MetaDescriptionEn" class="form-label fw-medium">Description (EN)</label>
                <textarea asp-for="MetaDescriptionEn" class="form-control" rows="3" maxlength="320"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="MetaDescriptionAr" class="form-label fw-medium">Description (AR)</label>
                <textarea asp-for="MetaDescriptionAr" class="form-control" rows="3" dir="rtl" maxlength="320"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="MetaKeywordsEn" class="form-label fw-medium">Keywords (EN)</label>
                <input asp-for="MetaKeywordsEn" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="MetaKeywordsAr" class="form-label fw-medium">Keywords (AR)</label>
                <input asp-for="MetaKeywordsAr" class="form-control" dir="rtl" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-medium">Open Graph Image (1200×630 recommended)</label>
                @if (!string.IsNullOrEmpty(Model.OpenGraphImage))
                {
                    <div class="image-preview-lg mb-2"><img src="@Model.OpenGraphImage" alt="" /></div>
                }
                <div class="input-group">
                    <input asp-for="OpenGraphImage" class="form-control" placeholder="/uploads/media/..." />
                    <button type="button" class="btn btn-outline-secondary" data-media-picker data-media-target="#OpenGraphImage" data-media-category="backgrounds">
                        <i class="bi bi-images"></i>
                    </button>
                </div>
                <input type="file" name="ogImageFile" class="form-control mt-2" accept="image/*" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-medium">Favicon</label>
                @if (!string.IsNullOrEmpty(Model.FaviconUrl))
                {
                    <div class="image-preview mb-2"><img src="@Model.FaviconUrl" alt="" /></div>
                }
                <div class="input-group">
                    <input asp-for="FaviconUrl" class="form-control" placeholder="/uploads/media/..." />
                    <button type="button" class="btn btn-outline-secondary" data-media-picker data-media-target="#FaviconUrl" data-media-category="logos">
                        <i class="bi bi-images"></i>
                    </button>
                </div>
                <input type="file" name="faviconFile" class="form-control mt-2" accept="image/*" />
            </div>
        </div>
    </div>

    <div class="content-card mb-4">
        <div class="d-flex align-items-center mb-3">
            <span class="card-icon"><i class="bi bi-bar-chart-line"></i></span>
            <div>
                <h5 class="mb-0">Analytics</h5>
                <small class="text-muted">Optional tracking</small>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="GoogleAnalyticsCode" class="form-label fw-medium">Google Analytics ID</label>
                <input asp-for="GoogleAnalyticsCode" class="form-control" placeholder="G-XXXXXXXXXX" maxlength="60" />
            </div>
        </div>
    </div>

    <div class="content-card mb-4">
        <div class="d-flex align-items-center mb-3">
            <span class="card-icon"><i class="bi bi-palette"></i></span>
            <div>
                <h5 class="mb-0">Brand Colors</h5>
                <small class="text-muted">Used by the homepage gradient</small>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="PrimaryColor" class="form-label fw-medium">Primary</label>
                <div class="input-group">
                    <input asp-for="PrimaryColor" type="color" class="form-control form-control-color" />
                    <input asp-for="PrimaryColor" class="form-control" placeholder="#6366F1" />
                </div>
            </div>
            <div class="col-md-3">
                <label asp-for="SecondaryColor" class="form-label fw-medium">Secondary</label>
                <div class="input-group">
                    <input asp-for="SecondaryColor" type="color" class="form-control form-control-color" />
                    <input asp-for="SecondaryColor" class="form-control" placeholder="#A855F7" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 sticky-bottom-bar">
        <button type="submit" class="btn btn-gradient">
            <i class="bi bi-check-lg"></i> Save Settings
        </button>
    </div>
</form>
