@model List<TechStackItem>
@{
    ViewData["Title"] = "Tech Stack";
}

<div class="content-card mb-4">
    <div class="d-flex align-items-center mb-3">
        <span class="card-icon"><i class="bi bi-cpu"></i></span>
        <div>
            <h5 class="mb-0">Add Technology</h5>
            <small class="text-muted">The stack badges shown on the homepage</small>
        </div>
    </div>

    <form asp-action="Save" method="post" enctype="multipart/form-data" class="row g-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="0" />

        <div class="col-md-3">
            <label class="form-label fw-medium">Name</label>
            <input name="Name" class="form-control" required maxlength="80" placeholder=".NET 8" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-medium">Bootstrap Icon</label>
            <input name="IconClass" class="form-control" placeholder="bi-microsoft" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-medium">Icon URL (Library / upload)</label>
            <div class="input-group">
                <input name="IconUrl" id="TS_IconUrl" class="form-control" placeholder="/uploads/media/icons/..." />
                <button type="button" class="btn btn-outline-secondary" data-media-picker data-media-target="#TS_IconUrl" data-media-category="icons">
                    <i class="bi bi-images"></i>
                </button>
            </div>
            <input type="file" name="iconFile" class="form-control mt-2" accept="image/*" />
        </div>
        <div class="col-md-1">
            <label class="form-label fw-medium">Order</label>
            <input name="DisplayOrder" type="number" class="form-control" min="0" value="0" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check form-switch">
                <input type="hidden" name="IsActive" value="false" />
                <input class="form-check-input" type="checkbox" role="switch" name="IsActive" value="true" checked />
                <label class="form-check-label">Active</label>
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-gradient"><i class="bi bi-plus-lg"></i> Add</button>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="mb-0">All Technologies</h6>
        <small class="text-muted">@Model.Count total</small>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-cpu text-muted"></i><h6 class="mt-3">No items yet</h6></div>
    }
    else
    {
        <div class="techstack-admin-grid">
            @foreach (var t in Model)
            {
                <div class="tech-tile">
                    <div class="tech-tile-icon">
                        @if (!string.IsNullOrEmpty(t.IconUrl))
                        { <img src="@t.IconUrl" alt="" /> }
                        else if (!string.IsNullOrEmpty(t.IconClass))
                        { <i class="bi @t.IconClass"></i> }
                        else
                        { <i class="bi bi-cpu"></i> }
                    </div>
                    <div class="tech-tile-name">@t.Name</div>
                    <div class="tech-tile-order">#@t.DisplayOrder</div>
                    @if (!t.IsActive) { <span class="tech-tile-badge">Hidden</span> }
                    <form asp-action="Delete" method="post" class="confirm-delete" data-confirm="Delete @t.Name?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button class="btn btn-sm btn-outline-danger w-100 mt-2"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            }
        </div>
    }
</div>
