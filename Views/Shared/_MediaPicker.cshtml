<!-- Shared media picker. Triggered by any element with: data-media-picker data-media-target="#inputId" data-media-category="hero" -->
<div class="modal fade media-picker-modal" id="mediaPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-images"></i>
                    Select from Media Library
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="media-picker-toolbar">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="mpSearch" type="text" class="form-control" placeholder="Search by file name or alt text..." />
                    </div>
                    <select id="mpCategory" class="form-select" style="max-width: 220px;">
                        <option value="">All categories</option>
                        @foreach (var cat in Msa3edcomAdmin.Models.MediaCategories.All)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>

                <div id="mpGrid" class="media-picker-grid">
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-arrow-clockwise"></i> Loading…
                    </div>
                </div>

                <div id="mpEmpty" class="empty-state d-none">
                    <i class="bi bi-images text-muted"></i>
                    <h6 class="mt-3">No media yet</h6>
                    <p class="text-muted small mb-2">Upload images from the Media Library page.</p>
                    <a href="/Media" class="btn btn-sm btn-outline-primary">Open Media Library</a>
                </div>

                <div id="mpPager" class="media-picker-pager"></div>
            </div>
        </div>
    </div>
</div>
