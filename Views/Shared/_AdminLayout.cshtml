@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var userEmail = user?.Email ?? "Admin";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string controller, string? action = null)
        => currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)
           && (action == null || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — msa3edcom Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">

        <!-- ===== Sidebar ===== -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-brand">
                <div class="brand-mark-sm">
                    <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
                        <defs>
                            <linearGradient id="adGrad" x1="0" y1="0" x2="40" y2="40">
                                <stop stop-color="#6366F1"/>
                                <stop offset="1" stop-color="#A855F7"/>
                            </linearGradient>
                        </defs>
                        <rect width="40" height="40" rx="10" fill="url(#adGrad)"/>
                        <path d="M10 28V14l6 8 6-8v14M24 28V14l6 14" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div>
                    <div class="brand-name">msa3edcom</div>
                    <div class="brand-sub">Admin CMS</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-group-label">Overview</div>
                <a asp-controller="Admin" asp-action="Index" class="sidebar-link @(IsActive("Admin", "Index") ? "active" : "")">
                    <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                </a>
                <a asp-controller="Leads" asp-action="Index" class="sidebar-link @(IsActive("Leads") ? "active" : "")">
                    <i class="bi bi-inbox"></i><span>Lead Requests</span>
                </a>

                <div class="sidebar-group-label">Content</div>
                <a asp-controller="Admin" asp-action="Settings" class="sidebar-link @(IsActive("Admin", "Settings") ? "active" : "")">
                    <i class="bi bi-gear"></i><span>Site Content</span>
                </a>
                <a asp-controller="Services" asp-action="Index" class="sidebar-link @(IsActive("Services") ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap"></i><span>Services</span>
                </a>
                <a asp-controller="Portfolio" asp-action="Index" class="sidebar-link @(IsActive("Portfolio") ? "active" : "")">
                    <i class="bi bi-collection"></i><span>Portfolio</span>
                </a>
                <a asp-controller="Testimonials" asp-action="Index" class="sidebar-link @(IsActive("Testimonials") ? "active" : "")">
                    <i class="bi bi-chat-quote"></i><span>Testimonials</span>
                </a>
                <a asp-controller="Faq" asp-action="Index" class="sidebar-link @(IsActive("Faq") ? "active" : "")">
                    <i class="bi bi-question-circle"></i><span>FAQ</span>
                </a>
                <a asp-controller="TechStack" asp-action="Index" class="sidebar-link @(IsActive("TechStack") ? "active" : "")">
                    <i class="bi bi-cpu"></i><span>Tech Stack</span>
                </a>
                <a asp-controller="Stats" asp-action="Index" class="sidebar-link @(IsActive("Stats") ? "active" : "")">
                    <i class="bi bi-bar-chart"></i><span>Statistics</span>
                </a>
                <a asp-controller="Process" asp-action="Index" class="sidebar-link @(IsActive("Process") ? "active" : "")">
                    <i class="bi bi-diagram-3"></i><span>Process</span>
                </a>
                <a asp-controller="Admin" asp-action="Clients" class="sidebar-link @(IsActive("Admin", "Clients") ? "active" : "")">
                    <i class="bi bi-building"></i><span>Clients</span>
                </a>

                <div class="sidebar-group-label">Library</div>
                <a asp-controller="Media" asp-action="Index" class="sidebar-link @(IsActive("Media") ? "active" : "")">
                    <i class="bi bi-images"></i><span>Media Library</span>
                </a>

                <div class="sidebar-group-label">Config</div>
                <a asp-controller="SiteSettings" asp-action="Index" class="sidebar-link @(IsActive("SiteSettings") ? "active" : "")">
                    <i class="bi bi-sliders"></i><span>SEO &amp; Branding</span>
                </a>

                <div class="sidebar-divider"></div>

                <a asp-controller="Home" asp-action="Index" target="_blank" class="sidebar-link">
                    <i class="bi bi-box-arrow-up-right"></i><span>View Site</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar">@(userEmail.Length > 0 ? userEmail[0].ToString().ToUpper() : "A")</div>
                    <div class="user-info">
                        <div class="user-name">@userEmail</div>
                        <div class="user-role">Administrator</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <!-- ===== Main ===== -->
        <main class="admin-main">
            <header class="admin-topbar">
                <button class="sidebar-toggle d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
                <div class="topbar-actions ms-auto">
                    <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-eye"></i> Preview
                    </a>
                </div>
            </header>

            <div class="admin-content">
                <div id="toastStack" class="toast-stack" aria-live="polite" aria-atomic="true">
                    @if (TempData["Success"] != null)
                    {
                        <div class="toast-card toast-success">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@TempData["Success"]</span>
                            <button type="button" class="toast-close" aria-label="Close">&times;</button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="toast-card toast-error">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@TempData["Error"]</span>
                            <button type="button" class="toast-close" aria-label="Close">&times;</button>
                        </div>
                    }
                </div>

                @RenderBody()
            </div>
        </main>
    </div>

    @await Html.PartialAsync("_MediaPicker")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
