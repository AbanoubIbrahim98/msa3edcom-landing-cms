@model List<StatItem>
@{
    ViewData["Title"] = "Statistics";
}

<div class="content-card mb-4">
    <div class="d-flex align-items-center mb-3">
        <span class="card-icon"><i class="bi bi-bar-chart"></i></span>
        <div>
            <h5 class="mb-0">Add Statistic</h5>
            <small class="text-muted">Animated counters shown on the homepage</small>
        </div>
    </div>

    <form asp-action="Save" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="0" />

        <div class="col-md-3">
            <label class="form-label fw-medium">Label (EN)</label>
            <input name="LabelEn" class="form-control" required maxlength="80" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-medium">Label (AR)</label>
            <input name="LabelAr" class="form-control" dir="rtl" required maxlength="80" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-medium">Value</label>
            <input name="Value" class="form-control" required maxlength="20" placeholder="120" />
        </div>
        <div class="col-md-1">
            <label class="form-label fw-medium">Suffix</label>
            <input name="Suffix" class="form-control" placeholder="+" maxlength="10" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-medium">Icon</label>
            <input name="IconClass" class="form-control" placeholder="bi-rocket" />
        </div>
        <div class="col-md-1">
            <label class="form-label fw-medium">Order</label>
            <input name="DisplayOrder" type="number" class="form-control" min="0" value="0" />
        </div>
        <div class="col-12">
            <div class="form-check form-switch mb-3">
                <input type="hidden" name="IsActive" value="false" />
                <input class="form-check-input" type="checkbox" role="switch" name="IsActive" value="true" checked />
                <label class="form-check-label">Active</label>
            </div>
            <button type="submit" class="btn btn-gradient"><i class="bi bi-plus-lg"></i> Add Stat</button>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="mb-0">All Statistics</h6>
        <small class="text-muted">@Model.Count total</small>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-bar-chart text-muted"></i><h6 class="mt-3">No statistics yet</h6></div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var s in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="stat-tile">
                        <div class="stat-tile-icon"><i class="bi @(s.IconClass ?? "bi-graph-up")"></i></div>
                        <div class="stat-tile-value">@s.Value@s.Suffix</div>
                        <div class="stat-tile-label">@s.LabelEn</div>
                        <div class="stat-tile-label-ar" dir="rtl">@s.LabelAr</div>
                        @if (!s.IsActive) { <span class="status-pill is-off mb-2"><span class="dot"></span> Hidden</span> }
                        <form asp-action="Delete" method="post" class="confirm-delete mt-2" data-confirm="Delete this stat?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
