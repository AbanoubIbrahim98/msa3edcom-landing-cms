@model List<ServiceItem>
@{
    ViewData["Title"] = "Services";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0">All Services</h5>
        <small class="text-muted">@Model.Count total · active items appear on the public site</small>
    </div>
    <a asp-action="Create" class="btn btn-gradient">
        <i class="bi bi-plus-lg"></i> New Service
    </a>
</div>

<div class="content-card p-0">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-grid-3x3-gap text-muted"></i>
            <h6 class="mt-3">No services yet</h6>
            <p class="text-muted small mb-0">Add your first service from the button above.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle data-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">Icon</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th style="width: 120px;">Order</th>
                        <th style="width: 100px;">Status</th>
                        <th style="width: 220px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <div class="row-icon">
                                @if (!string.IsNullOrEmpty(s.IconUrl))
                                {
                                    <img src="@s.IconUrl" alt="" />
                                }
                                else if (!string.IsNullOrEmpty(s.IconClass))
                                {
                                    <i class="bi @s.IconClass"></i>
                                }
                                else
                                {
                                    <i class="bi bi-grid"></i>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="fw-medium">@s.TitleEn</div>
                            <div class="text-muted small" dir="rtl">@s.TitleAr</div>
                        </td>
                        <td class="text-muted small text-truncate" style="max-width:320px;">@s.DescriptionEn</td>
                        <td>
                            <form asp-action="Reorder" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="hidden" name="direction" value="-1" />
                                <button class="btn btn-sm btn-outline-secondary" title="Move up"><i class="bi bi-arrow-up"></i></button>
                            </form>
                            <span class="mx-1 small text-muted">@s.DisplayOrder</span>
                            <form asp-action="Reorder" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="hidden" name="direction" value="1" />
                                <button class="btn btn-sm btn-outline-secondary" title="Move down"><i class="bi bi-arrow-down"></i></button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="ToggleActive" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button class="status-pill @(s.IsActive ? "is-on" : "is-off")">
                                    <span class="dot"></span> @(s.IsActive ? "Active" : "Hidden")
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline confirm-delete" data-confirm="Delete this service?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
