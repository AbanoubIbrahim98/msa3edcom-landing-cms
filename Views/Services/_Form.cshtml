@model ServiceItem

<div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="TitleEn" class="form-label fw-medium">Title (English)</label>
        <input asp-for="TitleEn" class="form-control" required maxlength="150" />
        <span asp-validation-for="TitleEn" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TitleAr" class="form-label fw-medium">Title (Arabic)</label>
        <input asp-for="TitleAr" class="form-control" dir="rtl" required maxlength="150" />
        <span asp-validation-for="TitleAr" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="DescriptionEn" class="form-label fw-medium">Description (English)</label>
        <textarea asp-for="DescriptionEn" class="form-control" rows="4" maxlength="800"></textarea>
    </div>
    <div class="col-md-6">
        <label asp-for="DescriptionAr" class="form-label fw-medium">Description (Arabic)</label>
        <textarea asp-for="DescriptionAr" class="form-control" rows="4" dir="rtl" maxlength="800"></textarea>
    </div>

    <div class="col-md-4">
        <label asp-for="IconClass" class="form-label fw-medium">Bootstrap Icon class</label>
        <input asp-for="IconClass" class="form-control" placeholder="bi-code-slash" />
        <small class="form-text text-muted">e.g. <code>bi-code-slash</code></small>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-medium">Icon (image)</label>
        @if (!string.IsNullOrEmpty(Model.IconUrl))
        {
            <div class="image-preview mb-2"><img src="@Model.IconUrl" alt="" /></div>
        }
        <div class="input-group">
            <input asp-for="IconUrl" class="form-control" placeholder="/uploads/media/icons/..." />
            <button type="button" class="btn btn-outline-secondary" data-media-picker data-media-target="#IconUrl" data-media-category="icons">
                <i class="bi bi-images"></i>
            </button>
        </div>
        <input type="file" name="iconFile" class="form-control mt-2" accept="image/*" />
    </div>

    <div class="col-md-4">
        <label class="form-label fw-medium">Image (large card)</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="image-preview mb-2"><img src="@Model.ImageUrl" alt="" /></div>
        }
        <div class="input-group">
            <input asp-for="ImageUrl" class="form-control" placeholder="/uploads/media/services/..." />
            <button type="button" class="btn btn-outline-secondary" data-media-picker data-media-target="#ImageUrl" data-media-category="services">
                <i class="bi bi-images"></i>
            </button>
        </div>
        <input type="file" name="imageFile" class="form-control mt-2" accept="image/*" />
    </div>

    <div class="col-md-3">
        <label asp-for="DisplayOrder" class="form-label fw-medium">Display Order</label>
        <input asp-for="DisplayOrder" type="number" class="form-control" min="0" />
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
    </div>
</div>

<div class="d-flex gap-2 sticky-bottom-bar">
    <button type="submit" class="btn btn-gradient">
        <i class="bi bi-check-lg"></i> Save Service
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>
